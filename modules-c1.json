        {
          "type": "choose",
          "prompt": "«Rarely ___ such an extraordinary discovery.» — Inversion to'g'ri shakli?",
          "options": ["have I witnessed", "I have witnessed", "did I witnessed", "I witnessed"],
          "answer": "have I witnessed",
          "word": { "en": "rarely have I...", "uz": "inversiya: kamdan-kam holatda men ko'rganman" }
        },
        {
          "type": "write",
          "prompt": "«Not only did he succeed, ___ he also inspired others.» — juft bog'lovchi so'zni yozing:",
          "answer": "but",
          "word": { "en": "not only... but also", "uz": "nafaqat... balki ham" }
        },
        {
          "type": "choose",
          "prompt": "Inversion (Inverted sentence structure) akademik yozuvda nima beradi?",
          "options": ["Stylistic emphasis va ritorik ta'sirchanlik", "Grammatik xato hosil qiladi", "Gapni qisqartiradi", "Faqat ogzaki nutqda ishlatiladi"],
