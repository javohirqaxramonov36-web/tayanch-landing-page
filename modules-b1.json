          "type": "choose",
          "prompt": "«If it rains tomorrow, we ___ stay at home.» — 1st Conditional?",
          "options": ["will", "would", "are", "were"],
          "answer": "will",
          "word": { "en": "first conditional", "uz": "real kelajak sharti (if + present, will)" }
        },
        {
          "type": "write",
          "prompt": "«If I had money, I ___ buy a car.» (2nd Conditional):",
          "answer": "would",
          "word": { "en": "second conditional", "uz": "noreal hozirgi shart (if + past, would)" }
        },
        {
          "type": "choose",
          "prompt": "«If I were you, I would take this course.» — Bu nima bildiradi?",
          "options": ["Maslahat berish", "Buyruq berish", "Savol berish", "Shikoyat qilish"],
          "answer": "Maslahat berish",
          "word": { "en": "if I were you", "uz": "sizning o'rningizda bo'lganimda" }
        }
      ]
    },
