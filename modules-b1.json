          "prompt": "«I have ___ London twice.» — mos o'tgan zamon sifatdoshi?",
          "options": ["visited", "visit", "visiting", "visits"],
          "answer": "visited",
          "word": { "en": "visit / visited", "uz": "tashrif buyurmoq / bo'lmoq" }
        },
        {
          "type": "write",
          "prompt": "«He has ___ his key.» (yo'qotmoq — lose fe'lining III shakli):",
          "answer": "lost",
          "word": { "en": "lose / lost", "uz": "yo'qotmoq / yo'qotgan" }
        },
        {
          "type": "choose",
          "prompt": "«Have you ever try sushi?» gapida qaysi grammatik xato bor?",
          "options": ["«try» o'rniga «tried» bo'lishi kerak", "«ever» bo'lmasligi kerak", "«Have» o'rniga «Has» bo'lishi kerak", "Xato yo'q"],
          "answer": "«try» o'rniga «tried» bo'lishi kerak",
          "word": { "en": "have you ever...?", "uz": "hech qachon ... qilganmisiz?" }
        }
      ]
    },
    {
